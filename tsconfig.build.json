{
  "compilerOptions": {
    "outDir": "dist",
    "strict": true,
    "module": "CommonJS",
    "target": "es2020",
    "declaration": true,
    "declarationDir": "dist",
    "esModuleInterop": true,
    "baseUrl": "./src",
    "paths": {
      "@bryandollery/ai-agents": [
        "./"
      ]
    },
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "types": [
      "node",
      "jest"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
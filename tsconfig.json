{
  "compilerOptions": {
    "outDir": "dist",
    "strict": true,
    "module": "CommonJS",
    "target": "es2020",
    "declaration": true,
    "declarationDir": "dist",
    "esModuleInterop": true,
    "baseUrl": "./src",
    "paths": {
      "@bryandollery/ai-agents": [
        "./"
      ]
    },
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*",
    "test/**/*",
    "examples/**/*"
  ],
  "exclude": [
    "node_modules"
  ]
}